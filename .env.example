OPENAI_API_KEY=
ANTHROPIC_API_KEY=          # only if the answer model is Anthropic
EMBEDDING_MODEL=text-embedding-3-small
ANSWER_MODEL=gpt-5.4-mini    # an OpenAI model id your key can use
ANSWER_MODE=                # oneshot | agentic, default set from eval results
JUDGE_MODEL=                # optional: model for the eval judge (defaults to ANSWER_MODEL)

# Database (started with `docker compose up -d`)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Same user, password and database as above
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<db>
